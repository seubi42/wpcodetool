; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "SignaConnect"
#define MyAppVersion "1.0"
#define MyAppPublisher "SMBB"
#define MyAppURL "https://www.smbb.fr"
#define MyAppExeName "SignaConnectUpload.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{7C6EED7C-4AEC-4FE8-A390-9B06415CABAC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
; Mise à jour depuis SignConnect : installer dans le nouveau dossier, pas dans l'ancien.
UsePreviousAppDir=no
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
OutputBaseFilename=signaconnect-setup
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\Storage\Projects\wpcodetool\win_client\SignaConnectUpload\bin\Debug\net481\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Storage\Projects\wpcodetool\win_client\SignaConnectUpload\bin\Debug\net481\SignaConnectUpload.exe.config"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Storage\Projects\wpcodetool\win_client\SignaConnectUpload\bin\Debug\net481\SignaConnectUpload.pdb"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Storage\Projects\wpcodetool\win_client\SignaConnectUpload\bin\Debug\net481\System.Web.dll"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[InstallDelete]
; Ancienne installation (SignConnect) : supprimée lors de la mise à jour.
Type: filesandordirs; Name: "{autopf}\SignConnect"
Type: files; Name: "{autoprograms}\SignConnect.lnk"
Type: files; Name: "{autodesktop}\SignConnect.lnk"

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

