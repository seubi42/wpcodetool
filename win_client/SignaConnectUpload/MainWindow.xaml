<Window x:Class="SignaConnectUpload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SignaConnect" Icon="signaconnect.ico"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <!-- Signature qui se dessine puis s'efface, en boucle, pendant l'envoi. -->
        <Storyboard x:Key="Drawing" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Signature" Storyboard.TargetProperty="StrokeDashOffset">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="18" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="-18">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Ondes autour du logo pendant l'envoi. -->
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.9" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.9" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.9" Duration="0:0:1.6" BeginTime="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.9" Duration="0:0:1.6" BeginTime="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.6" BeginTime="0:0:0.8" />
        </Storyboard>

        <!-- Barre de progression indéterminée. -->
        <Storyboard x:Key="BarMove" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BarShift" Storyboard.TargetProperty="X" From="-140" To="400" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Envoi réussi : le logo passe au vert et une coche se dessine. -->
        <Storyboard x:Key="Done">
            <DoubleAnimation Storyboard.TargetName="SuccessMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="StrokeDashOffset" From="8" To="0" Duration="0:0:0.45" BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Erreur : la carte « dit non ». -->
        <Storyboard x:Key="Shake">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardShift" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-9" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="8" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.19" Value="-6" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.26" Value="4" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.33" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Apparition de la fenêtre. -->
        <Storyboard x:Key="Appear">
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="CardShift" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Marge autour de la carte pour son ombre. -->
    <Border x:Name="Card" Margin="28,20,28,40" Background="White" CornerRadius="20"
            BorderBrush="{StaticResource Line}" BorderThickness="1" MouseLeftButtonDown="OnDragWindow">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardShift" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Color="#0F172A" Opacity="0.22" />
        </Border.Effect>

        <Grid>
            <Button x:Name="CloseButton" Content="✕" Style="{StaticResource Link}" FontSize="14"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Padding="8,4"
                    ToolTip="Fermer" Click="OnCancel" />

            <StackPanel Margin="32,36,32,28">
                <!-- Logo : même icône que la page de connexion de SignaConnect. -->
                <Grid Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MarkScale" CenterX="26" CenterY="26" />
                    </Grid.RenderTransform>
                    <Border x:Name="Wave1" CornerRadius="15" Background="{StaticResource MarkGradient}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                    </Border>
                    <Border x:Name="Wave2" CornerRadius="15" Background="{StaticResource MarkGradient}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                    </Border>
                    <Border CornerRadius="15" Background="{StaticResource MarkGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource BrandColor}" BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.45" />
                        </Border.Effect>
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Signature" Data="M3,17 c3,-1 4,-9 6,-9 s0,7 2,7 s2,-4 4,-4 s1,3 3,3 s2,-1 3,-2"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeDashCap="Round" StrokeLineJoin="Round" StrokeDashArray="18 18" StrokeDashOffset="0" />
                                <Path Data="M3,21 h18" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Border x:Name="SuccessMark" CornerRadius="15" Background="{StaticResource Success}" Opacity="0">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Check" Data="M6,12.5 l4,4 l8,-9" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" StrokeLineJoin="Round"
                                      StrokeDashArray="8 8" StrokeDashOffset="8" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>

                <TextBlock x:Name="TitleText" Text="Connexion" Style="{StaticResource Title}" />
                <TextBlock x:Name="LeadText" Text="Accédez à votre espace de signature." Style="{StaticResource Lead}" />

                <!-- Connexion -->
                <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
                    <TextBlock Text="Adresse du site" Style="{StaticResource Label}" />
                    <TextBox x:Name="UrlBox" />
                    <TextBlock Text="Identifiant ou adresse e-mail" Style="{StaticResource Label}" />
                    <TextBox x:Name="LoginBox" />
                    <TextBlock Text="Mot de passe" Style="{StaticResource Label}" />
                    <PasswordBox x:Name="PasswordBox" />
                    <Button x:Name="LoginButton" Content="Se connecter" Style="{StaticResource Primary}" IsDefault="True" Margin="0,6,0,0" Click="OnLogin" />
                    <TextBlock Text="Le mot de passe n'est pas enregistré sur ce poste." Foreground="{StaticResource Muted}" FontSize="12.5"
                               TextAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Connecté, sans fichier : zone de dépôt -->
                <StackPanel x:Name="HomePanel" Visibility="Collapsed">
                    <Border x:Name="DropZone" CornerRadius="14" Background="{StaticResource Soft}" Cursor="Hand" MouseLeftButtonUp="OnPick">
                        <Grid>
                            <Rectangle x:Name="DropBorder" RadiusX="14" RadiusY="14" Stroke="{StaticResource InputLine}" StrokeThickness="1.5" StrokeDashArray="5 4" />
                            <StackPanel HorizontalAlignment="Center" Margin="20,26">
                                <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,16 V4 M7,9 l5,-5 l5,5 M4,16 v3 a1,1 0 0 0 1,1 h14 a1,1 0 0 0 1,-1 v-3"
                                              Stroke="{StaticResource Brand}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Glissez un PDF ici" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,2" />
                                <TextBlock Text="ou cliquez pour en choisir un" Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Astuce : imprimez vers l'imprimante PDF « SignaConnect » depuis n'importe quel logiciel."
                               Foreground="{StaticResource Muted}" FontSize="12.5" TextAlignment="Center" Margin="8,14,8,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Content="Ouvrir SignaConnect" Style="{StaticResource Link}" Click="OnOpenApp" />
                        <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="4,0" VerticalAlignment="Center" />
                        <Button Content="Se déconnecter" Style="{StaticResource Link}" Click="OnLogout" />
                    </StackPanel>
                </StackPanel>

                <!-- Envoi d'un fichier -->
                <StackPanel x:Name="UploadPanel" Visibility="Collapsed">
                    <Border CornerRadius="12" Background="{StaticResource Soft}" Padding="12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="44" CornerRadius="6" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0">
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-4,0,0,7" CornerRadius="3" Background="{StaticResource Brand}" Padding="4,1">
                                    <TextBlock Text="PDF" Foreground="White" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="FileName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock x:Name="FileDetails" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="TeamPanel" Visibility="Collapsed">
                        <TextBlock Text="Envoyer depuis l'équipe" Style="{StaticResource Label}" />
                        <ComboBox x:Name="TeamBox" />
                    </StackPanel>

                    <Button x:Name="UploadButton" Content="Continuer dans le navigateur" Style="{StaticResource Primary}" IsDefault="True" Margin="0,6,0,0" Click="OnUpload" />

                    <!-- Barre de progression indéterminée, aux couleurs du logo. -->
                    <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{StaticResource Line}" Margin="0,6,0,0" ClipToBounds="True" Visibility="Collapsed">
                        <Border Width="140" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource MarkGradient}">
                            <Border.RenderTransform><TranslateTransform x:Name="BarShift" X="-140" /></Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="Status" Margin="0,16,0,0" FontSize="13" TextAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
