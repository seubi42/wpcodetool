{
  "name": "passflow_invoice",
  "label": "Facture",
  "pluralLabel": "Factures",
  "description": "Factures et avoirs émis : tout est figé à l'émission (numéro, coordonnées, lignes, totaux, PDF).",
  "storage": {
    "table": "passflow_invoice",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "number": {
      "type": "varchar",
      "length": 40,
      "nullable": false,
      "default": ""
    },
    "kind": {
      "type": "varchar",
      "length": 10,
      "nullable": false,
      "default": "invoice"
    },
    "demo": {
      "type": "tinyint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "order_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "origin_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "customer_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "email": {
      "type": "varchar",
      "length": 190,
      "nullable": false,
      "default": ""
    },
    "name": {
      "type": "varchar",
      "length": 190,
      "nullable": false,
      "default": ""
    },
    "billing": {
      "type": "longtext",
      "nullable": true
    },
    "items": {
      "type": "longtext",
      "nullable": true
    },
    "taxes": {
      "type": "longtext",
      "nullable": true
    },
    "total_ht": {
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0
    },
    "total_tax": {
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0
    },
    "total_ttc": {
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0
    },
    "payment": {
      "type": "varchar",
      "length": 190,
      "nullable": false,
      "default": ""
    },
    "source": {
      "type": "varchar",
      "length": 20,
      "nullable": false,
      "default": "online"
    },
    "note": {
      "type": "text",
      "nullable": true
    },
    "author": {
      "type": "varchar",
      "length": 20,
      "nullable": false,
      "default": "team"
    },
    "file": {
      "type": "varchar",
      "length": 255,
      "nullable": false,
      "default": ""
    },
    "hash": {
      "type": "varchar",
      "length": 64,
      "nullable": false,
      "default": ""
    },
    "issued_at": {
      "type": "datetime",
      "nullable": true
    },
    "created_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    }
  },
  "indexes": [
    {
      "name": "idx_number",
      "type": "unique",
      "columns": [
        "number"
      ]
    },
    {
      "name": "idx_order_id",
      "type": "index",
      "columns": [
        "order_id"
      ]
    },
    {
      "name": "idx_origin_id",
      "type": "index",
      "columns": [
        "origin_id"
      ]
    },
    {
      "name": "idx_customer_id",
      "type": "index",
      "columns": [
        "customer_id"
      ]
    },
    {
      "name": "idx_issued_at",
      "type": "index",
      "columns": [
        "issued_at"
      ]
    }
  ],
  "admin": {
    "enabled": false
  },
  "api": {
    "enabled": false
  }
}
