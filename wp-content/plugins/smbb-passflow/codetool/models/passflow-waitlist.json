{
  "name": "passflow_waitlist",
  "label": "Demande en attente",
  "pluralLabel": "Liste d'attente",
  "description": "Les personnes qui attendent une place sur un créneau complet, dans l'ordre d'arrivée.",
  "storage": {
    "table": "passflow_waitlist",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "slot_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "customer_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "first_name": {
      "type": "varchar",
      "length": 100,
      "nullable": false,
      "default": ""
    },
    "last_name": {
      "type": "varchar",
      "length": 100,
      "nullable": false,
      "default": ""
    },
    "email": {
      "type": "varchar",
      "length": 190,
      "nullable": false,
      "default": ""
    },
    "phone": {
      "type": "varchar",
      "length": 40,
      "nullable": false,
      "default": ""
    },
    "places": {
      "type": "smallint",
      "unsigned": true,
      "nullable": false,
      "default": 1
    },
    "status": {
      "type": "varchar",
      "length": 20,
      "nullable": false,
      "default": "waiting"
    },
    "notified_at": {
      "type": "datetime",
      "nullable": true
    },
    "expires_at": {
      "type": "datetime",
      "nullable": true
    },
    "booking_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "notes": {
      "type": "longtext",
      "nullable": true
    },
    "creation_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "create_datetime"
    },
    "creation_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "create_user"
    },
    "lastupdate_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "update_datetime"
    },
    "lastupdate_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "update_user"
    }
  },
  "indexes": [
    {
      "name": "idx_slot_id",
      "type": "index",
      "columns": [
        "slot_id"
      ]
    },
    {
      "name": "idx_status",
      "type": "index",
      "columns": [
        "status"
      ]
    }
  ],
  "admin": {
    "enabled": true,
    "capability": "manage_passflow",
    "menu": {
      "placement": "hidden",
      "title": "Liste d'attente",
      "icon": "dashicons-list-view",
      "position": 50,
      "parent": "smbb-codetool-passflow",
      "highlight": "passflow_booking"
    },
    "adminBar": {
      "newContent": false,
      "shortcut": false
    },
    "list": {
      "perPage": 30,
      "search": {
        "enabled": true,
        "provider": "default",
        "fields": [
          "first_name",
          "last_name",
          "email",
          "phone"
        ],
        "mode": "or",
        "placeholder": "Nom, e-mail ou téléphone"
      },
      "filters": {
        "enabled": true,
        "fields": [
          {
            "field": "slot_id",
            "label": "Créneau",
            "operators": [
              "eq"
            ]
          },
          {
            "field": "status",
            "label": "Statut",
            "operators": [
              "eq"
            ]
          }
        ]
      },
      "defaultOrder": {
        "by": "id",
        "direction": "asc"
      }
    },
    "views": {
      "list": "views/passflow-waitlist/list.php",
      "form": "views/passflow-waitlist/form.php"
    }
  },
  "hooks": {
    "file": "hooks/WaitlistHooks.php",
    "class": "Smbb\\Passflow\\CodeTool\\WaitlistHooks"
  },
  "api": {
    "enabled": false
  }
}
