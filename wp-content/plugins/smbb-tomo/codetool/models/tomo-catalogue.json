{
  "name": "tomo_catalogue",
  "label": "Catalogue",
  "pluralLabel": "Catalogue sur place",
  "description": "Les produits que l'équipe vend sur place depuis la feuille d'appel, rangés en catalogues et sous-catalogues.",
  "storage": {
    "table": "tomo_catalogue",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "name": {
      "type": "varchar",
      "length": 190,
      "nullable": false,
      "default": ""
    },
    "parent_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "position": {
      "type": "int",
      "nullable": false,
      "default": 0
    },
    "active": {
      "type": "tinyint",
      "unsigned": true,
      "nullable": false,
      "default": 1
    },
    "atelier_ids": {
      "type": "longtext",
      "nullable": true,
      "format": "json"
    },
    "intervenant_ids": {
      "type": "longtext",
      "nullable": true,
      "format": "json"
    },
    "product_ids": {
      "type": "longtext",
      "nullable": true,
      "format": "json"
    },
    "notes": {
      "type": "longtext",
      "nullable": true
    },
    "creation_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "create_datetime"
    },
    "creation_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "create_user"
    },
    "lastupdate_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "update_datetime"
    },
    "lastupdate_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "update_user"
    }
  },
  "indexes": [
    {
      "name": "idx_parent_id",
      "type": "index",
      "columns": [
        "parent_id"
      ]
    }
  ],
  "admin": {
    "enabled": true,
    "capability": "manage_tomo",
    "menu": {
      "placement": "submenu",
      "title": "Catalogue sur place",
      "icon": "dashicons-store",
      "position": 74,
      "parent": "smbb-codetool-tomo",
      "group": "Paramétrage"
    },
    "adminBar": {
      "newContent": false,
      "shortcut": false
    },
    "list": {
      "perPage": 100,
      "search": {
        "enabled": false
      },
      "filters": {
        "enabled": false
      },
      "defaultOrder": {
        "by": "position",
        "direction": "asc"
      }
    },
    "views": {
      "list": "views/tomo-catalogue/list.php",
      "form": "views/tomo-catalogue/form.php"
    }
  },
  "hooks": {
    "file": "hooks/CatalogueHooks.php",
    "class": "Smbb\\Tomo\\CodeTool\\CatalogueHooks"
  },
  "api": {
    "enabled": false
  }
}
