{
  "name": "tomo_inscription",
  "label": "Inscription",
  "pluralLabel": "Inscriptions",
  "description": "Une ligne par participant et par place. Une réservation sans date attend un nouveau créneau.",
  "storage": {
    "table": "tomo_inscription",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "creneau_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "atelier_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "customer_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "first_name": {
      "type": "varchar",
      "length": 100,
      "nullable": false,
      "default": ""
    },
    "last_name": {
      "type": "varchar",
      "length": 100,
      "nullable": false,
      "default": ""
    },
    "email": {
      "type": "varchar",
      "length": 190,
      "nullable": false,
      "default": ""
    },
    "phone": {
      "type": "varchar",
      "length": 40,
      "nullable": false,
      "default": ""
    },
    "allergies": {
      "type": "text",
      "nullable": true
    },
    "level": {
      "type": "varchar",
      "length": 20,
      "nullable": false,
      "default": ""
    },
    "age": {
      "type": "smallint",
      "unsigned": true,
      "nullable": true
    },
    "notes": {
      "type": "longtext",
      "nullable": true
    },
    "source": {
      "type": "varchar",
      "length": 20,
      "nullable": false,
      "default": "manual"
    },
    "order_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "order_item_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "price_paid": {
      "type": "decimal",
      "precision": 10,
      "scale": 2,
      "nullable": true
    },
    "status": {
      "type": "varchar",
      "length": 20,
      "nullable": false,
      "default": "confirmed"
    },
    "checked_at": {
      "type": "datetime",
      "nullable": true
    },
    "intervenant_note": {
      "type": "longtext",
      "nullable": true
    },
    "pass_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "creation_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "create_datetime"
    },
    "creation_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "create_user"
    },
    "lastupdate_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "update_datetime"
    },
    "lastupdate_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "update_user"
    }
  },
  "indexes": [
    {
      "name": "idx_creneau_id",
      "type": "index",
      "columns": [
        "creneau_id"
      ]
    },
    {
      "name": "idx_atelier_id",
      "type": "index",
      "columns": [
        "atelier_id"
      ]
    },
    {
      "name": "idx_status",
      "type": "index",
      "columns": [
        "status"
      ]
    },
    {
      "name": "idx_customer_id",
      "type": "index",
      "columns": [
        "customer_id"
      ]
    },
    {
      "name": "idx_order_id",
      "type": "index",
      "columns": [
        "order_id"
      ]
    },
    {
      "name": "idx_email",
      "type": "index",
      "columns": [
        "email"
      ]
    },
    {
      "name": "idx_pass_id",
      "type": "index",
      "columns": [
        "pass_id"
      ]
    }
  ],
  "admin": {
    "enabled": true,
    "capability": "manage_tomo",
    "menu": {
      "placement": "submenu",
      "title": "Inscriptions",
      "icon": "dashicons-groups",
      "position": 30,
      "parent": "smbb-codetool-tomo",
      "group": "Au quotidien"
    },
    "adminBar": {
      "newContent": false,
      "shortcut": false
    },
    "list": {
      "perPage": 30,
      "search": {
        "enabled": true,
        "provider": "default",
        "fields": [
          "first_name",
          "last_name",
          "email",
          "phone"
        ],
        "mode": "or",
        "placeholder": "Nom, e-mail ou téléphone"
      },
      "filters": {
        "enabled": true,
        "form": false,
        "fields": [
          {
            "field": "creneau_id",
            "label": "Créneau",
            "operators": [
              "eq",
              "empty"
            ]
          },
          {
            "field": "atelier_id",
            "label": "Atelier",
            "operators": [
              "eq"
            ]
          },
          {
            "field": "status",
            "label": "Statut",
            "operators": [
              "eq"
            ]
          },
          {
            "field": "source",
            "label": "Source",
            "operators": [
              "eq"
            ]
          }
        ]
      },
      "presets": {
        "all": "Toutes",
        "items": [
          {
            "key": "pending",
            "label": "À confirmer",
            "filter": {
              "field": "status",
              "operator": "eq",
              "value": "pending"
            },
            "count": true
          },
          {
            "key": "confirmed",
            "label": "Payées",
            "filter": {
              "field": "status",
              "operator": "eq",
              "value": "confirmed"
            }
          },
          {
            "key": "present",
            "label": "Présents",
            "filter": {
              "field": "status",
              "operator": "eq",
              "value": "present"
            }
          },
          {
            "key": "absent",
            "label": "Absents",
            "filter": {
              "field": "status",
              "operator": "eq",
              "value": "absent"
            }
          },
          {
            "key": "cancelled",
            "label": "Annulées",
            "filter": {
              "field": "status",
              "operator": "eq",
              "value": "cancelled"
            }
          }
        ]
      },
      "remember": "back",
      "defaultOrder": {
        "by": "id",
        "direction": "desc"
      }
    },
    "views": {
      "list": "views/tomo-inscription/list.php",
      "form": "views/tomo-inscription/form.php",
      "details": "views/tomo-inscription/details.php"
    }
  },
  "hooks": {
    "file": "hooks/InscriptionHooks.php",
    "class": "Smbb\\Tomo\\CodeTool\\InscriptionHooks"
  },
  "api": {
    "enabled": false
  }
}
