{
  "apiVersion": 2,
  "name": "smbb-wpdocux/device-walkthrough",
  "title": "DocUX device",
  "category": "media",
  "description": "Show numbered documentation steps inside a simulated phone or tablet.",
  "textdomain": "smbb-wpdocux",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "attributes": {
    "format": {
      "type": "string",
      "default": "landscape"
    },
    "transition": {
      "type": "string",
      "default": "fade"
    },
    "indicatorStyle": {
      "type": "string",
      "default": "numbers"
    },
    "buttonFontSize": {
      "type": "number",
      "default": 14
    }
  },
  "editorScript": "file:./editor.js",
  "script": "file:./view.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
