{
  "name": "scp_audit_log",
  "label": "Événement d'audit",
  "pluralLabel": "Journal d'audit",
  "description": "Journal d'audit SignaConnect.",
  "storage": {
    "table": "scp_audit_log",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "organization_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "document_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "event_type": {
      "type": "varchar",
      "length": 80,
      "nullable": false,
      "default": ""
    },
    "event_date": {
      "type": "datetime",
      "nullable": true
    },
    "actor_type": {
      "type": "varchar",
      "length": 20,
      "nullable": false,
      "default": "system"
    },
    "actor_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "actor_ip": {
      "type": "varchar",
      "length": 64,
      "nullable": true
    },
    "message": {
      "type": "text",
      "nullable": true
    },
    "context": {
      "type": "json",
      "nullable": true
    },
    "creation_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "create_datetime"
    }
  },
  "indexes": [
    {
      "name": "idx_organization_id",
      "type": "index",
      "columns": [
        "organization_id"
      ]
    },
    {
      "name": "idx_document_id",
      "type": "index",
      "columns": [
        "document_id"
      ]
    },
    {
      "name": "idx_event_type",
      "type": "index",
      "columns": [
        "event_type"
      ]
    },
    {
      "name": "idx_event_date",
      "type": "index",
      "columns": [
        "event_date"
      ]
    }
  ],
  "hooks": {
    "file": "hooks/AuditLogHooks.php",
    "class": "Smbb\\SignConnectProxima\\CodeTool\\AuditLogHooks"
  },
  "admin": {
    "enabled": true,
    "capability": "manage_options",
    "menu": {
      "placement": "submenu",
      "parent": "smbb-codetool-scp",
      "title": "Journal d'audit",
      "icon": "dashicons-list-view",
      "position": 7,
      "group": "Activité"
    },
    "adminBar": {
      "newContent": false,
      "shortcut": false
    },
    "list": {
      "perPage": 25,
      "search": {
        "enabled": true,
        "provider": "default",
        "fields": [
          "event_type",
          "message"
        ],
        "mode": "or",
        "placeholder": "Rechercher"
      },
      "filters": {
        "enabled": true,
        "fields": [
          {
            "field": "organization_id",
            "label": "Organisation",
            "operators": [
              "eq"
            ]
          },
          {
            "field": "event_type",
            "label": "Événement",
            "operators": [
              "eq"
            ]
          },
          {
            "field": "actor_type",
            "label": "Acteur",
            "operators": [
              "eq"
            ]
          }
        ]
      },
      "defaultOrder": {
        "by": "id",
        "direction": "desc"
      }
    },
    "views": {
      "list": "views/scp-audit-log/list.php"
    }
  },
  "api": {
    "enabled": false
  }
}
