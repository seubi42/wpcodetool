{
    "name": "smbb/wpcodetool",
    "description": "Lightweight toolkit for declarative admin pages, custom tables, option-backed settings pages, and REST API helpers.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4 <9.0",
        "aws/aws-sdk-php": "^3.380",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required when using Smbb\\WpCodeTool\\Connector\\SmbbS3Client."
    },
    "autoload": {
        "psr-4": {
            "Smbb\\WpCodeTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Smbb\\WpCodeTool\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "test:unit": "php tests/run.php"
    }
}
