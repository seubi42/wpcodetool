{
  "name": "signdocument",
  "label": "Sign document",
  "pluralLabel": "Sign documents",
  "description": "Documents managed by SignConnect to track creation and signature.",
  "storage": {
    "table": "signdocument",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "filename": {
      "type": "varchar",
      "length": 255,
      "nullable": false,
      "default": ""
    },
    "storage_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "storage_path": {
      "type": "varchar",
      "length": 1024,
      "nullable": true
    },
    "signed_storage_path": {
      "type": "varchar",
      "length": 1024,
      "nullable": true
    },
    "file_size": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "signed_file_size": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "document_status": {
      "type": "varchar",
      "length": 50,
      "nullable": false,
      "default": "draft"
    },
    "send_channel": {
      "type": "varchar",
      "length": 20,
      "nullable": true
    },
    "recipient_email": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    },
    "recipient_phone": {
      "type": "varchar",
      "length": 60,
      "nullable": true
    },
    "send_message": {
      "type": "text",
      "nullable": true
    },
    "require_identity_photo": {
      "type": "tinyint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "identity_photo_storage_path": {
      "type": "varchar",
      "length": 1024,
      "nullable": true
    },
    "identity_photo_file_size": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "identity_photo_mime_type": {
      "type": "varchar",
      "length": 100,
      "nullable": true
    },
    "identity_photo_filename": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    },
    "return_expected": {
      "type": "varchar",
      "length": 30,
      "nullable": false,
      "default": "signature"
    },
    "link_expires_at": {
      "type": "datetime",
      "nullable": true
    },
    "sent_date": {
      "type": "datetime",
      "nullable": true
    },
    "sent_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "signature_token": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    },
    "token_hash": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    },
    "sent_count": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "last_opened_date": {
      "type": "datetime",
      "nullable": true
    },
    "opened_count": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "signer_contact": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    },
    "signer_first_name": {
      "type": "varchar",
      "length": 120,
      "nullable": true
    },
    "signer_last_name": {
      "type": "varchar",
      "length": 120,
      "nullable": true
    },
    "signer_place": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    },
    "signer_return_status": {
      "type": "varchar",
      "length": 30,
      "nullable": true
    },
    "signer_return_message": {
      "type": "text",
      "nullable": true
    },
    "signer_latitude": {
      "type": "decimal",
      "precision": 10,
      "scale": 7,
      "nullable": true
    },
    "signer_longitude": {
      "type": "decimal",
      "precision": 10,
      "scale": 7,
      "nullable": true
    },
    "signature_data": {
      "type": "longtext",
      "nullable": true
    },
    "system_log": {
      "type": "longtext",
      "nullable": true
    },
    "signer_ip": {
      "type": "varchar",
      "length": 60,
      "nullable": true
    },
    "signer_user_agent": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    },
    "creation_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "create_datetime"
    },
    "creation_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "create_user"
    },
    "sign_date": {
      "type": "datetime",
      "nullable": true
    },
    "signed_pdf_date": {
      "type": "datetime",
      "nullable": true
    },
    "sign_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "token": {
      "type": "varchar",
      "length": 255,
      "nullable": true
    }
  },
  "indexes": [
    {
      "name": "idx_filename",
      "type": "index",
      "columns": ["filename"]
    },
    {
      "name": "idx_storage_id",
      "type": "index",
      "columns": ["storage_id"]
    },
    {
      "name": "idx_storage_path",
      "type": "index",
      "columns": [
        {
          "name": "storage_path",
          "length": 191
        }
      ]
    },
    {
      "name": "idx_signed_storage_path",
      "type": "index",
      "columns": [
        {
          "name": "signed_storage_path",
          "length": 191
        }
      ]
    },
    {
      "name": "idx_file_size",
      "type": "index",
      "columns": ["file_size"]
    },
    {
      "name": "idx_document_status",
      "type": "index",
      "columns": ["document_status"]
    },
    {
      "name": "idx_send_channel",
      "type": "index",
      "columns": ["send_channel"]
    },
    {
      "name": "idx_recipient_email",
      "type": "index",
      "columns": ["recipient_email"]
    },
    {
      "name": "idx_signature_token",
      "type": "index",
      "columns": ["signature_token"]
    },
    {
      "name": "idx_token_hash",
      "type": "index",
      "columns": ["token_hash"]
    },
    {
      "name": "idx_last_opened_date",
      "type": "index",
      "columns": [
        {
          "name": "last_opened_date",
          "order": "desc"
        }
      ]
    },
    {
      "name": "idx_sent_date",
      "type": "index",
      "columns": [
        {
          "name": "sent_date",
          "order": "desc"
        }
      ]
    },
    {
      "name": "idx_signer_contact",
      "type": "index",
      "columns": ["signer_contact"]
    },
    {
      "name": "idx_link_expires_at",
      "type": "index",
      "columns": [
        {
          "name": "link_expires_at",
          "order": "desc"
        }
      ]
    },
    {
      "name": "idx_token",
      "type": "index",
      "columns": ["token"]
    },
    {
      "name": "idx_creation_date",
      "type": "index",
      "columns": [
        {
          "name": "creation_date",
          "order": "desc"
        }
      ]
    }
  ],
  "hooks": {
    "file": "hooks/SignDocumentHooks.php",
    "class": "Smbb\\SignConnect\\CodeTool\\SignDocumentHooks"
  },
  "admin": {
    "enabled": true,
    "capability": "manage_options",
    "menu": {
      "placement": "submenu",
      "parent": "smbb-codetool-signconnect",
      "title": "Documents",
      "icon": "dashicons-media-document",
      "position": 10
    },
    "adminBar": {
      "newContent": false,
      "shortcut": false
    },
    "list": {
      "perPage": 20,
      "search": {
        "enabled": true,
        "provider": "default",
        "fields": ["filename", "storage_path", "token"],
        "mode": "or",
        "placeholder": "Search documents"
      },
      "filters": {
        "enabled": true,
        "fields": [
          {
            "field": "filename",
            "label": "Filename",
            "operators": ["contains", "eq", "starts_with", "ends_with", "empty", "not_empty"]
          },
          {
            "field": "storage_id",
            "label": "Storage",
            "operators": ["eq", "empty", "not_empty"]
          },
          {
            "field": "storage_path",
            "label": "Storage path",
            "operators": ["contains", "eq", "starts_with", "ends_with", "empty", "not_empty"]
          },
          {
            "field": "file_size",
            "label": "File size",
            "operators": ["eq", "gt", "gte", "lt", "lte"]
          },
          {
            "field": "document_status",
            "label": "Status",
            "operators": ["eq", "contains", "empty", "not_empty"]
          },
          {
            "field": "recipient_email",
            "label": "Recipient email",
            "operators": ["contains", "eq", "empty", "not_empty"]
          },
          {
            "field": "sign_date",
            "label": "Sign date",
            "operators": ["eq", "gt", "gte", "lt", "lte", "empty", "not_empty"]
          }
        ]
      },
      "defaultOrder": {
        "by": "id",
        "direction": "desc"
      }
    },
    "views": {
      "list": "views/signdocument/list.php",
      "form": "views/signdocument/form.php",
      "details": "views/signdocument/details.php"
    }
  },
  "api": {
    "enabled": false
  }
}
