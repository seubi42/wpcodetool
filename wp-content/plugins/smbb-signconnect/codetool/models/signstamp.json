{
  "name": "signstamp",
  "label": "Sender stamp",
  "pluralLabel": "Sender stamps",
  "description": "Reusable stamp images that can be applied to sender stamp fields.",
  "storage": {
    "table": "signstamp",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "name": {
      "type": "varchar",
      "length": 180,
      "nullable": false,
      "default": ""
    },
    "image_attachment_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "is_active": {
      "type": "tinyint",
      "unsigned": true,
      "nullable": false,
      "default": 1
    },
    "creation_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "create_datetime"
    },
    "creation_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "create_user"
    },
    "lastupdate_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "update_datetime"
    },
    "lastupdate_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "update_user"
    }
  },
  "indexes": [
    {
      "name": "idx_name",
      "type": "index",
      "columns": ["name"]
    },
    {
      "name": "idx_active",
      "type": "index",
      "columns": ["is_active"]
    }
  ],
  "admin": {
    "enabled": true,
    "capability": "manage_options",
    "menu": {
      "placement": "submenu",
      "parent": "smbb-codetool-signconnect",
      "title": "Stamps",
      "icon": "dashicons-format-image",
      "position": 20
    },
    "adminBar": {
      "newContent": false,
      "shortcut": false
    },
    "list": {
      "perPage": 20,
      "defaultOrder": {
        "by": "id",
        "direction": "desc"
      }
    },
    "views": {
      "list": "views/signstamp/list.php",
      "form": "views/signstamp/form.php",
      "details": "views/signstamp/details.php"
    }
  },
  "api": {
    "enabled": false
  }
}
