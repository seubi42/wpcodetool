{
  "name": "signusersignature",
  "label": "Sender signature",
  "pluralLabel": "Sender signatures",
  "description": "Sender signature drawings captured when sending SignConnect documents.",
  "storage": {
    "table": "signusersignature",
    "primaryKey": "id"
  },
  "columns": {
    "id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false,
      "autoIncrement": true,
      "primary": true
    },
    "user_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": false
    },
    "document_id": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true
    },
    "signature_data": {
      "type": "longtext",
      "nullable": false
    },
    "is_reusable": {
      "type": "tinyint",
      "unsigned": true,
      "nullable": false,
      "default": 0
    },
    "creation_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "create_datetime"
    },
    "creation_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "create_user"
    },
    "lastupdate_date": {
      "type": "datetime",
      "nullable": true,
      "managed": "update_datetime"
    },
    "lastupdate_by": {
      "type": "bigint",
      "unsigned": true,
      "nullable": true,
      "managed": "update_user"
    }
  },
  "indexes": [
    {
      "name": "idx_user",
      "type": "index",
      "columns": ["user_id"]
    },
    {
      "name": "idx_document",
      "type": "index",
      "columns": ["document_id"]
    },
    {
      "name": "idx_reusable",
      "type": "index",
      "columns": ["user_id", "is_reusable"]
    }
  ],
  "admin": {
    "enabled": true,
    "capability": "manage_options",
    "menu": {
      "placement": "submenu",
      "parent": "smbb-codetool-signconnect",
      "title": "Sender signatures",
      "icon": "dashicons-edit-page",
      "position": 21
    },
    "adminBar": {
      "newContent": false,
      "shortcut": false
    },
    "list": {
      "perPage": 20,
      "defaultOrder": {
        "by": "id",
        "direction": "desc"
      }
    },
    "views": {
      "list": "views/signusersignature/list.php",
      "form": "views/signusersignature/form.php",
      "details": "views/signusersignature/details.php"
    }
  },
  "api": {
    "enabled": false
  }
}
